# ============================================================
# PERLLON — Environment configuration
# ============================================================
# Copy this file to `.env.local` (and/or `.env`) and fill in the values.
# NEVER commit `.env.local` or any file containing real secrets.
#
# These values are PUBLIC (safe to expose in the browser client):
#   - VITE_SUPABASE_URL       → your Supabase project URL
#   - VITE_SUPABASE_ANON_KEY  → the `anon` publishable key ONLY
#
# NEVER put into the frontend:
#   - service_role key
#   - database password / connection string
#   - JWT secret
#   - any private token
# The `anon` key is rate-limited by RLS and is designed to be public.

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLISHABLE-KEY